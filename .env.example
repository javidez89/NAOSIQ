# Public values: never put a secret or service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact browser origin. No wildcard; do not infer it from user headers.
APP_ORIGIN=http://localhost:3000
# Demo is isolated from real data and disabled unless explicitly requested.
ENABLE_DEMO=false
# Production release is deliberately closed until independently verified.
RELEASE_APPROVED=false
# Token aleatorio de 32+ caracteres, sólo servidor, para /api/ready.
READINESS_TOKEN=
# Optional operational metadata, never credentials.
APP_ENV=development
# UI switch only. The provider also requires the Supabase config below.
GOOGLE_AUTH_ENABLED=false
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
