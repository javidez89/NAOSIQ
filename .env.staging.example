# Plantilla de staging. Copiar a un almacén seguro; nunca confirmar valores reales.
APP_ENV=staging
APP_ORIGIN=https://staging.example.invalid
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_test_replace_me

# Piloto sintético: debe permanecer false hasta autorización expresa de D11.
ALLOW_REAL_DATA=false
SYNTHETIC_PILOT_ONLY=true

# Integraciones externas: todas apagadas hasta aprobar D10 y aportar credenciales de ensayo.
GOOGLE_AUTH_ENABLED=false
WHATSAPP_PROVIDER_ENABLED=false
PAYMENT_GATEWAY_ENABLED=false
EMAIL_PROVIDER_ENABLED=false
SENTRY_ENABLED=false
