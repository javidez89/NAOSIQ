{
  "name": "crm-techi-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10"
  },
  "scripts": {
    "local": "node scripts/local-start.mjs",
    "local:serve": "node scripts/local-serve.mjs",
    "local:seed": "node scripts/local-seed.mjs",
    "test:local": "playwright test --config playwright.local.config.ts",
    "bootstrap": "node scripts/bootstrap.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "node scripts/test-unit.mjs",
    "test:e2e": "playwright test",
    "visual:v6": "node scripts/visual-compare-v6.mjs",
    "check:staging": "node scripts/check-staging-config.mjs .env.staging",
    "pilot:synthetic": "node scripts/synthetic-pilot.mjs",
    "local:outbox:inspect": "node scripts/local-outbox-drain.mjs",
    "test:db": "supabase test db",
    "db:init": "node scripts/init-db.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset:local": "supabase db reset --local",
    "db:types": "node scripts/db-types.mjs",
    "check:repo": "node scripts/check-repo.mjs",
    "check:naosiq": "node scripts/check-naosiq.mjs",
    "check:br02": "node scripts/check-br02.mjs",
    "check:br03": "node scripts/check-br03.mjs",
    "check:p01": "node scripts/check-p01.mjs",
    "check:p02": "node scripts/check-p02.mjs",
    "check:p03": "node scripts/check-p03.mjs",
    "check:p04": "node scripts/check-p04.mjs",
    "check:p05": "node scripts/check-p05.mjs",
    "check:ready": "node scripts/check-repo.mjs --ready",
    "check": "npm run check:repo && npm run lint && npm run typecheck && npm run test:unit",
    "preview:offline": "node scripts/preview-server.mjs",
    "prebuild": "node scripts/check-env.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.114.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "pdf-lib": "1.17.1",
    "server-only": "0.0.1",
    "@next/env": "16.3.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.18.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.4",
    "supabase": "2.117.0",
    "typescript": "5.9.3"
  },
  "license": "UNLICENSED"
}
